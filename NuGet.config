<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Öffentliches Backend (Platform.Maui.Linux.Gtk4) + alle transitiven Pakete -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- DevFlow.Agent.Gtk/Core/Logging: nirgends öffentlich, aus maui-labs (external/maui-labs) gebaut.
         Rebuild: external/maui-labs/.dotnet/dotnet pack <projekt> -c Release  →  hierher kopieren. -->
    <add key="local-devflow" value="localfeed" />
  </packageSources>
</configuration>
