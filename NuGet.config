<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Transitive Pakete (GirCore, Microsoft.Maui.Controls …) -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Lokaler Feed für Pakete, die (noch) nicht auf nuget.org liegen:
         (1) GTK4-Backend Microsoft.Maui.Platforms.Linux.Gtk4(.Essentials) — CI-Artefakt
             aus dotnet/maui-labs PR #359, bis maui-labs offiziell veröffentlicht.
         (2) DevFlow.Agent.Gtk/Core/Logging — aus external/maui-labs gebaut.
             Rebuild: external/maui-labs/.dotnet/dotnet pack <projekt> -c Release → hierher. -->
    <add key="local-devflow" value="localfeed" />
  </packageSources>
</configuration>
