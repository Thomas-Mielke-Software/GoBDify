<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GoBDify.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GoBDify"
    xmlns:views="clr-namespace:GoBDify.Views"
    Shell.FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="#1F2937"
    Title="GoBDify">

    <Shell.FlyoutHeader>
        <Grid HeightRequest="120" BackgroundColor="#5d76dd" Padding="20">
            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                <Label Text="GoBDify" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                <Label Text="Manipulationssichere Ordnerhistorie" FontSize="11" TextColor="#E5E7EB"/>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.FlyoutContentTemplate>
        <DataTemplate>
            <views:FlyoutContent />
        </DataTemplate>
    </Shell.FlyoutContentTemplate>

    <ShellContent
        x:Name="HomeShellContent"
        Title="Übersicht"
        Route="home"
        ContentTemplate="{DataTemplate views:HomePage}" />

    <ShellContent
        Title="Einstellungen"
        Route="settings"
        ContentTemplate="{DataTemplate views:SettingsPage}" />

</Shell>
