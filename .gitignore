.claude
**/bin/
**/obj/
GoBDify/GoBDify.csproj.user

# Publish-Profile (lokal, projektspezifisch)
**/Properties/PublishProfiles/

# MSIX-Builds und Vorgängerversionen
*.msix
*.msixupload
*.msix.zip
*.back(*).aip

# Distributions-Ordner mit gepackten CLI-Binaries
/dist/

# Staging-Ordner für CLI-Publish vor dem Zippen
/publish/
/GoBDify.Cli/publish/
/GoBDify.Core/publish/

# Upload-Staging für easyct.de (umbenannte MSIX + .appinstaller)
/ftp-upload/

# Android-Signaturkeystore (privat, lokal lassen)
*.keystore

# Testartefakte aus Audit/Timestamp-Läufen im Repo-Root
/timestamp*.sha256
/timestamp*.sha256.tst

# Lokale Kopien von publizieren.bat in Subfolders (Master liegt im Repo-Root)
/GoBDify/publizieren.bat
/GoBDify.Cli/publizieren.bat
/GoBDify.Cli/publizieren-cli.bat

