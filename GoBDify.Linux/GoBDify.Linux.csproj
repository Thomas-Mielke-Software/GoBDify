<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>false</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Namespace GoBDify, damit App/AppShell aus GoBDify.UI direkt passen. -->
    <RootNamespace>GoBDify</RootNamespace>
    <ApplicationTitle>GoBDify</ApplicationTitle>
    <ApplicationId>software.mielke.gobdify</ApplicationId>
    <Version>1.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- GTK4-Backend + Essentials aus dotnet/maui-labs. Der frühere Redth-Fork
         (Platform.Maui.Linux.Gtk4) ist eingestellt und ins offizielle maui-labs
         übergegangen. Bis maui-labs offiziell auf nuget.org veröffentlicht,
         beziehen wir das CI-Artefakt aus PR #359 über den lokalen Feed (localfeed).
         Enthält den DisplayActionSheet-Fix (WhereArrayIterator→string[]-Cast). -->
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="0.1.0-ci.510.1" />
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="0.1.0-ci.510.1" />
    <!-- Das maui-labs-Backend verlangt Microsoft.Maui.Controls >= 10.0.41; die
         geteilte GoBDify.UI referenziert $(MauiVersion) (10.0.31). Hier im Head
         explizit anheben, damit kein NU1605-Downgrade entsteht. Windows unberührt. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.41" />
    <ProjectReference Include="..\GoBDify.UI\GoBDify.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

</Project>
