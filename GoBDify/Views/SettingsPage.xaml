<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoBDify.Views.SettingsPage"
             Title="Einstellungen"
             BackgroundColor="#F3F4F6">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="720" HorizontalOptions="Center">

            <Label Text="Einstellungen" FontSize="22" FontAttributes="Bold" TextColor="#111827"/>

            <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="Paranoia-Modus" FontAttributes="Bold" TextColor="#111827" VerticalOptions="Center"/>
                    <Switch Grid.Column="1" x:Name="ParanoiaSwitch" Toggled="OnParanoiaToggled" VerticalOptions="Center"/>
                </Grid>
            </Border>

            <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="TsaSectionTitle" Text="Timestamp-Services" FontAttributes="Bold" TextColor="#111827"/>
                    <Label x:Name="TsaSectionHint" Text="Wähle einen RFC3161-Dienst. Im Paranoia-Modus müssen genau drei ausgewählt sein."
                           FontSize="12" TextColor="#6B7280"/>
                    <VerticalStackLayout x:Name="TsaList" Spacing="2"/>
                    <Label x:Name="ValidationLabel" Text="" FontSize="12" TextColor="#DC2626"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Über GoBDify" FontAttributes="Bold" TextColor="#111827"/>
                    <Label Text="GoBDify erzeugt eine veränderungsfreie Ordnerhistorie durch eine Hash-Kette mit RFC3161-Timestamps."
                           FontSize="12" TextColor="#6B7280"/>

                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8" Margin="0,8,0,0">
                        <Label Grid.Row="0" Grid.Column="0" Text="Version"   FontSize="12" TextColor="#6B7280"/>
                        <Label Grid.Row="0" Grid.Column="1" x:Name="VersionLabel" Text="" FontSize="12" TextColor="#111827"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Autor"     FontSize="12" TextColor="#6B7280"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="Thomas Mielke" FontSize="12" TextColor="#111827"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Copyright" FontSize="12" TextColor="#6B7280"/>
                        <Label Grid.Row="2" Grid.Column="1" Text="© 2024–2026 Thomas Mielke" FontSize="12" TextColor="#111827"/>

                        <Label Grid.Row="3" Grid.Column="0" Text="Lizenz"    FontSize="12" TextColor="#6B7280"/>
                        <Label Grid.Row="3" Grid.Column="1" x:Name="LicenseLink" FontSize="12" TextColor="#5d76dd" TextDecorations="Underline">
                            <Label.Text>GNU Affero General Public License v3.0</Label.Text>
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLicenseTapped"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <Label Grid.Row="4" Grid.Column="0" Text="Homepage"  FontSize="12" TextColor="#6B7280"/>
                        <Label Grid.Row="4" Grid.Column="1" x:Name="RepoLink" FontSize="12" TextColor="#5d76dd" TextDecorations="Underline">
                            <Label.Text>github.com/thomiel/GoBDify</Label.Text>
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRepoTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
