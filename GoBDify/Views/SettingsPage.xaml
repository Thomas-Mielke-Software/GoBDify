<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoBDify.Views.SettingsPage"
             Title="Einstellungen"
             BackgroundColor="#F3F4F6">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="720" HorizontalOptions="Center">

            <Label Text="Einstellungen" FontSize="22" FontAttributes="Bold" TextColor="#111827"/>

            <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Schweiz-Modus" FontAttributes="Bold" TextColor="#111827"/>
                            <Label Text="Jeder Timestamp wird gleichzeitig bei drei voneinander unabhängigen Zertifizierungsstellen beglaubigt. Hintergrund ist Art. 9 der Schweizerischen Geschäftsbücherverordnung (GeBüV, SR 221.431), der für die elektronische Aufbewahrung geschäftsrelevanter Unterlagen die unveränderbare Speicherung verlangt; die kombinierte Beglaubigung durch drei unabhängige Dienste ist die etablierte Umsetzung dieser Anforderung."
                                   FontSize="12" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="SwissSwitch" Toggled="OnSwissToggled" VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="TsaSectionTitle" Text="Timestamp-Services" FontAttributes="Bold" TextColor="#111827"/>
                    <Label x:Name="TsaSectionHint" Text="Wähle einen oder mehrere RFC3161-Dienste. Im Schweiz-Modus müssen genau drei ausgewählt sein."
                           FontSize="12" TextColor="#6B7280"/>
                    <VerticalStackLayout x:Name="TsaList" Spacing="2"/>
                    <Label x:Name="ValidationLabel" Text="" FontSize="12" TextColor="#DC2626"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Über" FontAttributes="Bold" TextColor="#111827"/>
                    <Label Text="GoBDify erzeugt eine veränderungsfreie Ordnerhistorie durch eine Hash-Kette mit RFC3161-Timestamps."
                           FontSize="12" TextColor="#6B7280"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
